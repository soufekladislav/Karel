APP_NAME=Karel 2.0
APP_URL=https://ai-coder.freshcrackers.cz
APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
DATABASE_URL=sqlite:///./storage/karel2.db
# MySQL example: mysql+pymysql://user:password@localhost/database?charset=utf8mb4

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_NOW
SUPERADMIN_EMAIL=soufek@freshcrackers.cz
ADMIN_NAME=Administrátor

FRESH_AI_ENGINE_URL=https://aiengine.freshcrackers.cz
FRESH_AI_ENGINE_CHAT_PATH=/v1/engine/run
FRESH_AI_ENGINE_HEALTH_PATH=/v1/health
FRESH_AI_ENGINE_API_KEY=
FRESH_AI_ENGINE_MODEL=karel
FRESH_AI_ENGINE_MODE=fresh
FRESH_AI_ENGINE_TIMEOUT=180

MAX_UPLOAD_MB=100
SESSION_HTTPS_ONLY=true

# Počet automatických opakování při dočasné chybě 429/502/503/504
FRESH_AI_ENGINE_RETRIES=3

# GitHub connector P1 (read only): access limited to the allowlisted owners.
# For a private repository use a fine-grained token with Contents, Issues,
# Pull requests, Actions read permissions; Projects v2 needs separate scope.
# Never paste the token into chat, GitHub Issues or the Karel UI.
GITHUB_ALLOWED_OWNERS=soufekladislav
GITHUB_READ_TOKEN=

# Explicit host allowlist for fetching remote JSON manifests (examples only).
# Add every real project host before deploying this change; no wildcard '*' value.
# Subdomains can use *.freshcrackers.cz; use only trusted domains.
MANIFEST_ALLOWED_HOSTS=
