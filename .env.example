APP_NAME=Karel 2.0
APP_URL=https://karel.freshcrackers.cz
APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
DATABASE_URL=sqlite:///./storage/karel2.db
# MySQL example: mysql+pymysql://user:password@localhost/database?charset=utf8mb4

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_NOW
SUPERADMIN_EMAIL=soufek@freshcrackers.cz
ADMIN_NAME=Administrátor

FRESH_AI_ENGINE_URL=https://aiengine.freshcrackers.cz
FRESH_AI_ENGINE_CHAT_PATH=/v1/engine/run
FRESH_AI_ENGINE_HEALTH_PATH=/v1/health
FRESH_AI_ENGINE_API_KEY=
FRESH_AI_ENGINE_MODEL=karel
FRESH_AI_ENGINE_MODE=fresh
FRESH_AI_ENGINE_TIMEOUT=180

MAX_UPLOAD_MB=100
SESSION_HTTPS_ONLY=true

# Počet automatických opakování při dočasné chybě 429/502/503/504
FRESH_AI_ENGINE_RETRIES=3
